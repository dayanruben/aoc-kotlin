{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "platformAutomerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates of stable (>=1.0) versions once required checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Auto-merge pin, digest and lockfile maintenance updates once required checks pass",
      "matchUpdateTypes": [
        "pin",
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "automerge": true
    }
  ]
}
